{
  "name": "ninewatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "build": "npm run typecheck:api && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "migrate": "tsx db/migrate.ts",
    "migrate:reset": "tsx db/reset.ts",
    "upload:sample": "tsx scripts/upload-sample.ts",
    "verify:stats": "tsx scripts/verify-stats.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vercel": "^59.23.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
